<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XY.SolidWorksPlugin</RootNamespace>
    <AssemblyName>XY.SolidWorksPlugin.SwAddin</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0649;CS8632</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\tools\Customize-RadialIcons.ps1" Link="Customize-RadialIcons.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Customize-RadialIcons.cmd" Link="Customize-RadialIcons.cmd" CopyToOutputDirectory="PreserveNewest" />
	<EmbeddedResource Include="ExternalCommandMappings.csv" />
    <EmbeddedResource Include="..\..\Resources\contact-wechat.jpg" LogicalName="XY.Contact.WeChat.jpg" />
    <EmbeddedResource Include="..\..\Resources\contact-douyin.jpg" LogicalName="XY.Contact.Douyin.jpg" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksInteropDirectory)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksInteropDirectory)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swcommands">
      <HintPath>$(SolidWorksInteropDirectory)\SolidWorks.Interop.swcommands.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksInteropDirectory)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
	<Reference Include="Accessibility" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="WindowsBase" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
</Project>
